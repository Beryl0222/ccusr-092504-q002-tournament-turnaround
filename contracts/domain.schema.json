{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "连续赛事场地转换中枢领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "TOURNAMENT_REGISTERED",
        "RESOURCE_REGISTERED",
        "ENTRY_CONFIRMED",
        "ENTRY_WITHDRAWN",
        "ALTERNATE_PROMOTED",
        "DRAW_STAGE_OPENED",
        "DRAW_STAGE_LOCKED",
        "SLOT_FILLED",
        "SLOT_VACATED",
        "MATCH_DEPENDENCY_SET",
        "MATCH_SCHEDULED",
        "MATCH_STARTED",
        "MATCH_COMPLETED",
        "SCHEDULE_REVISED",
        "PROPOSAL_SUBMITTED",
        "PROPOSAL_CONFIRMED",
        "PROPOSAL_REJECTED",
        "PROPOSAL_EXPIRED",
        "PROPOSAL_SUPERSEDED",
        "RESOURCE_HELD",
        "VENUE_RELEASED",
        "WAITLIST_JOINED",
        "WAITLIST_ADVANCED",
        "EQUIPMENT_DOWN",
        "EQUIPMENT_RESTORED",
        "PLAYER_MOVEMENT_RECORDED",
        "CONFIG_TRANSITION_RECORDED",
        "INSPECTION_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "tournament",
        "roster",
        "draw",
        "match",
        "venue_resource",
        "proposal",
        "player",
        "turnaround_plan"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
